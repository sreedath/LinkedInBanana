# PaperBanana / LinkedInBanana Environment Variables
# Copy this file to .env and fill in your keys.

# Google Gemini (free, no credit card): https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# YouTube Data API v3: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ── LinkedIn OAuth (optional, for direct posting) ─────────────────
# Create an app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Comma-separated list of email addresses allowed to post to LinkedIn
LINKEDIN_ALLOWED_EMAILS=rajatdandekar@vizuara.com

# ── SSL ────────────────────────────────────────────────────────────
# Set to true to skip SSL certificate verification (corporate proxies)
SKIP_SSL_VERIFICATION=false
